            "type": "text/javascript",
            "exec": [
              "pm.test(\"Health status\", function(){pm.response.to.have.status(200);});",
              "pm.test(\"Health service healthy\", function(){pm.expect(pm.response.json().status).to.eql('ok')});"
            ]
          }
        }
      ]
    },
